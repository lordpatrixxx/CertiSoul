# ==============================================================================
# HACKBLOX 2026 - Problem Statement 2: Environment Configuration
# ==============================================================================

# [Required for Live Cloud IPFS Pinning]
# Pinata JWT Token from https://app.pinata.cloud/developers/api-keys
# Kept strictly server-side by the Vite dev server / Node backend.
# If left blank, the application automatically uses the offline local IPFS mock simulator.
PINATA_JWT=

# [Optional: Sepolia Testnet Deployment]
# Sepolia RPC URL (e.g. Infura / Alchemy / Public RPC)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Deployer Private Key (without 0x prefix)
PRIVATE_KEY=
